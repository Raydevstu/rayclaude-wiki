# --- required in production
TIER1_ENV=production
TIER1_API_TOKEN=generate-a-long-random-token
TIER1_WEBHOOK_SECRET=generate-another-long-random-secret
# --- provider: mock | anthropic | openai (openai = any OpenAI-compatible endpoint)
TIER1_PROVIDER=anthropic
TIER1_PROVIDER_API_KEY=
# TIER1_PROVIDER_BASE_URL=
# TIER1_MODEL_SMALL=claude-haiku-5-5
# TIER1_MODEL_MEDIUM=claude-sonnet-5-5
# TIER1_MODEL_LARGE=claude-opus-5-5
# --- price table (USD per 1M tokens "input,output"); set to your contract prices
# TIER1_PRICE_SMALL=0.8,4
# TIER1_PRICE_MEDIUM=3,15
# TIER1_PRICE_LARGE=15,75
# --- limits and safety
TIER1_DAILY_BUDGET_USD=25
TIER1_AUDIT_THRESHOLD=0.85
TIER1_HTTP_ALLOWLIST=*            # comma-separated hosts, or * for any public host
TIER1_RATE_LIMIT_PER_MIN=60
# --- automation integrations (all optional)
# TIER1_SLACK_SIGNING_SECRET=        # enables POST /v1/slack/command and /v1/slack/events
# TIER1_SLACK_BOT_TOKEN=             # needed to reply to @mentions
# TIER1_NOTIFY_URL=https://hooks.slack.com/services/...   # job done/failed notifications (HMAC-signed when a webhook secret is set)
# TIER1_VAULT_DIR=vault              # folder inside the sandbox; auto-synced into notebook `vault` (Obsidian)
# TIER1_MAX_RALPH_ITERATIONS=3       # 1-5
# TIER1_SANDBOX_WRITABLE=1          # let the agent save notes into the sandbox (also remove :ro from the compose volume)
